{
  "name": "warmpet-api",
  "version": "0.1.0",
  "description": "微信小游戏宠物养成后端（NestJS + PostgreSQL + Redis）",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run lint:check",
    "build": "nest build",
    "build:web": "pnpm --dir admin-web install --prefer-offline && pnpm --dir admin-web build",
    "build:all": "npm run build:web && npm run build",
    "deploy": "bash scripts/deploy-admin.sh",
    "format": "prettier --write .",
    "format:all": "npm run format && pnpm --dir admin-web format",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src test scripts/dev scripts/ops scripts/*.js --fix",
    "lint:check": "eslint src test scripts/dev scripts/ops scripts/*.js --max-warnings 0",
    "verify": "npm run lint:check && tsc --noEmit && npm run check:circular && npm run verify:web && jest --silent && npm run test:e2e",
    "verify:web": "pnpm --dir admin-web lint && pnpm --dir admin-web typecheck && pnpm --dir admin-web test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "check:circular": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "script": "ts-node -T -P scripts/tsconfig.json",
    "seed:dev": "npm run script -- scripts/dev/seed-dev-players.ts",
    "clean:dev": "npm run script -- scripts/dev/clean-dev-players.ts",
    "wipe:pre-launch": "npm run script -- scripts/dev/wipe-pre-launch.ts",
    "prepare": "husky",
    "audit": "npm run script -- scripts/dev/audit-state.ts",
    "smoke:ledger": "npm run script -- scripts/dev/ledger-smoke.ts",
    "archive:entries": "npm run script -- scripts/ops/archive-entries.ts",
    "admin:passwd": "npm run script -- scripts/dev/admin-passwd.ts"
  },
  "lint-staged": {
    "{src,test,scripts/dev}/**/*.ts": [
      "eslint --max-warnings 0"
    ],
    "admin-web/**/*.{ts,tsx}": [
      "bash -c 'pnpm --dir admin-web lint'"
    ]
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 22,
        "branches": 20,
        "functions": 20,
        "lines": 22
      }
    },
    "testEnvironment": "node"
  }
}
