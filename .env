# ============================================================
# warmpet-backend 环境变量（明文 · 严禁提交到 git，已在 .gitignore 排除）
# ============================================================

# ---------- 应用 ----------
NODE_ENV=development
# DevBox 对外暴露端口为 8080（公网 https://ocqeeuitbygc.sealosbja.site → 8080）
PORT=8080
TZ=Asia/Shanghai
# 信任的反向代理跳数。显式写出而不是靠代码默认值：这个值决定后台登录频控按哪个 IP
# 计数，填小了 Sealos ingress 后面所有管理员会共用一个计数桶、20 次失败一起被锁在
# 门外；填大了 X-Forwarded-For 可被伪造。1 是在公网链路上实测确认过的（打一次失败
# 登录，Redis 里落的键是 login:fail:ip:<客户端真实出口 IP>）。
# 将来若在 DevBox 前面再叠一层网关（CDN、WAF），这个值要跟着加，复现方法同上。
TRUST_PROXY_HOPS=1
# CSP 档位：enforce | report-only | off。
# 当前 report-only：CSP 配错的表现是「后台样式全丢/白屏，但控制台只有几条报错」，
# 未经真实浏览器验证就 enforce 等于拿后台可用性赌一把，而本机没有任何浏览器。
# 违规现在会由浏览器自己上报到 /csp-report 并落 WARN 日志（[CspReport] 前缀），
# 所以转 enforce 的判据已经不需要有人盯控制台了：
#   pm2 logs warmpet-api --nostream --lines 2000 | grep CspReport
# 运营用真实浏览器把后台各页面走几遍，上面这条命令持续没有新输出即可改 enforce。
CSP_MODE=report-only

# ---------- PostgreSQL（Sealos 托管 · 内网地址）----------
DB_HOST=warmpet-pg-postgresql.ns-br0za7uc.svc
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sdgjxmrg
# 托管实例默认库为 postgres；如需专用库，另建 warmpet 后改此值
DB_NAME=postgres
# 外网直连串（仅本地 GUI 工具调试用，DevBox 内应走上面的内网地址）
DB_EXTERNAL_URL=postgresql://postgres:sdgjxmrg@dbconn.sealosbja.site:38065/?directConnection=true

# ---------- Redis（DevBox 本机 · PM2 守护）----------
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
JWT_SECRET=c1d991590cd3f6a6705f32da31340d1d10ddad296c3422a03ccc795bee0eca1e9006201933a7cffecef65fdd30b889ea
JWT_EXPIRES_IN=7d

# ---------- 后台管理端（RBAC）----------
ADMIN_JWT_EXPIRES_IN=1d
# 首次播种超管：仅当库内无任何管理员时生效。
ADMIN_INIT_USERNAME=13612227910
# 保留明文（本文件已 gitignore，且从不进镜像）：上一轮按「改密后清空」的约定清掉它，
# 结果是压平迁移要重建库时没人拿得出后台口令，只能重置。留着它，重建即可自动播种。
#
# 改密请用 `npm run admin:passwd`，它会同时改数据库和本行。
# 走后台 UI 的「重置密码」只改数据库，本行会静默过期；启动时的自检会 WARN 提醒。
ADMIN_INIT_PASSWORD=uD&VxYLqtw6Nb9fC9nsE
# 前端后台允许跨域源（逗号分隔）；留空则开发放开、生产同源
ADMIN_CORS_ORIGINS=

# ---------- 微信小游戏 ----------
WECHAT_APPID=wx5f58f7bfda8a7331
WECHAT_SECRET=1ba384c2668b1e17714d0d260a40d061
# 小程序代码上传密钥（miniprogram-ci 用），私钥文件路径
WECHAT_UPLOAD_PRIVATE_KEY_PATH=./secrets/private.wx5f58f7bfda8a7331.key

# ---------- Sealos 对象存储（S3 兼容）----------
SEALOS_BUCKET=br0za7uc-warmpet
SEALOS_BUCKET_ACL=publicRead
SEALOS_ACCESS_KEY=br0za7uc
SEALOS_SECRET_KEY=skxg8mk5gqfhf9xz
SEALOS_INTERNAL_ENDPOINT=http://object-storage.objectstorage-system.svc.cluster.local
SEALOS_EXTERNAL_ENDPOINT=https://objectstorageapi.bja.sealos.run
SEALOS_REGION=bja

# 联调假登录：code 形如 "mock:alice" 跳过微信校验直接签发 JWT。生产环境禁止为 true（启动会被 Joi 拒绝）
WECHAT_MOCK_LOGIN=true
