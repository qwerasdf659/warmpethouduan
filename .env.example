# ============================================================
# warmpet-backend 环境变量模板（占位符 · 可提交 git）
# 使用：复制为 .env 并填入真实值。真实 .env 已在 .gitignore 排除。
# ============================================================

# ---------- 应用 ----------
NODE_ENV=development
# 与 DevBox 暴露端口一致（本项目为 8080）
PORT=8080
TZ=Asia/Shanghai
# 信任的反向代理跳数。公网经 Sealos ingress 一层，故为 1；直连裸跑填 0。
# 影响后台登录频控按哪个 IP 计数，填错会把全部管理员锁在门外，改前先读 main.ts 注释。
TRUST_PROXY_HOPS=1
# CSP 档位：enforce | report-only | off。
# 新部署先留 report-only——CSP 配错的表现是样式全丢，像构建问题。
# 违规会由浏览器上报到 /csp-report 并落 WARN 日志，所以不需要有人盯 DevTools：
#   pm2 logs warmpet-api --nostream --lines 2000 | grep CspReport
# 用真实浏览器把后台各页面走几遍，上面这条持续无新输出即可改 enforce。
CSP_MODE=report-only

# ---------- PostgreSQL（Sealos 托管 · 内网地址）----------
DB_HOST=your-pg-host.svc
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=postgres
DB_EXTERNAL_URL=

# ---------- 连接池 / keepAlive（均可选，留空走代码默认值）----------
# 每进程最大连接数（PM2 cluster 下按 worker 数 × 该值估算总连接）
DB_POOL_MAX=20
# 最小连接（pg 软下限，减少冷启动握手）
DB_POOL_MIN=5
# 获取连接超时（毫秒，对应 Sequelize pool.acquire）
DB_POOL_ACQUIRE_MS=10000
# 空闲连接回收（毫秒，对应 Sequelize pool.idle）
DB_POOL_IDLE_MS=60000
# TCP keepAlive：true/false
DB_KEEPALIVE=true
# keepAlive 首次探测延迟（毫秒）
DB_KEEPALIVE_DELAY_MS=10000

# ---------- Redis（DevBox 本机 · PM2 守护）----------
REDIS_URL=redis://localhost:6379

# ---------- 全局限流（@nestjs/throttler，计数落 Redis）----------
# 粗粒度兜底额度，按「每 IP 每端点」分桶（handler 名一并哈希进计数键）。
# 玩法侧的每日上限由 game_config 管，这里只挡住脚本级的高频打点。
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ---------- JWT ----------
# 生成：openssl rand -hex 48
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# ---------- 后台管理端（RBAC）----------
# 后台 JWT 时效（比玩家端短）
ADMIN_JWT_EXPIRES_IN=1d
# 首次启动播种超管账号：仅当库内无任何管理员时生效。
ADMIN_INIT_USERNAME=admin
# 留空则不自动播种管理员。
#
# 两种用法，选一种并保持一致，别混着来：
#   a) 播种后清空本项——最安全，但重建数据库时没人拿得出口令，只能重置；
#   b) 长期保留明文，当作「重建库时的播种种子 + 口令备忘录」（本文件须 gitignore）。
#
# 若选 b，改密**必须**用 `npm run admin:passwd`：它会同时更新数据库与本行。
# 走后台「系统管理 → 管理员 → 重置密码」只改数据库，本行会静默变成旧值，
# 直到某天重建库才发现登不进去。应用启动时会比对两边，不一致会打 WARN。
ADMIN_INIT_PASSWORD=
# 前端后台允许的跨域源（逗号分隔，如 http://localhost:8000）；留空则开发放开、生产同源
ADMIN_CORS_ORIGINS=

# ---------- 游戏前端 / 通用登录 ----------
# 游戏前端（Unity WebGL 导出）托管域的跨域白名单（逗号分隔）。
# 原生 Unity（Android/iOS/Standalone）走 UnityWebRequest，不校验 CORS，无需在此配置。
GAME_CORS_ORIGINS=
# 通用登录（设备/账号）总开关。默认 true，供 Unity 原生/Steam 等非微信平台取得 JWT；
# 纯微信小游戏部署可设 false 关闭 /auth/login/device 与 /auth/{login,register}/account。
AUTH_GENERIC_LOGIN_ENABLED=true

# ---------- 微信小游戏 ----------
WECHAT_APPID=wxXXXXXXXXXXXXXXXX
WECHAT_SECRET=your_wechat_secret
# 小程序代码上传私钥路径。运行时代码不读它，属于发版链路（miniprogram-ci）。
# 密钥文件微信只给一次下载机会，删了要重新生成并重配 CI —— 别当死配置清理。
WECHAT_UPLOAD_PRIVATE_KEY_PATH=./secrets/private.wxXXXXXXXXXXXXXXXX.key
# 联调假登录开关：开启后可用 code="mock:alice" 免真机换 JWT（标识相同即同一玩家）。
# 这是鉴权绕过路径，NODE_ENV=production 时设为 true 会直接拒绝启动。
WECHAT_MOCK_LOGIN=false

# ---------- Sealos 对象存储（S3 兼容）----------
# 消费方：`npm run archive:entries`（分录分区归档转储，见 scripts/ops/）。
# 未配置或仍是 your_* 占位值时，归档脚本会跳过上传、只落本地文件，并拒绝 --drop。
#
# ⚠ SEALOS_BUCKET 必须写**完整桶名，含命名空间前缀**（形如 br0za7uc-warmpet），
# 不是控制台上显示的短名。写短名会得到一个含糊的 403 AccessDenied ——
# 签名是对的、桶不存在而已。查真实桶名：用 AK/SK 对端点做一次签名的 `GET /` 列桶。
SEALOS_BUCKET=your_ns_prefix-your_bucket
SEALOS_BUCKET_ACL=publicRead
SEALOS_ACCESS_KEY=your_access_key
SEALOS_SECRET_KEY=your_secret_key
SEALOS_INTERNAL_ENDPOINT=http://object-storage.objectstorage-system.svc.cluster.local
SEALOS_EXTERNAL_ENDPOINT=https://objectstorageapi.bja.sealos.run
SEALOS_REGION=bja
